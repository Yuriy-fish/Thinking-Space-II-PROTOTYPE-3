# GeoAnalog Matchmaker — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# NASA POWER API base endpoint (meteorological and solar data)
# Docs: https://power.larc.nasa.gov/docs/services/api/
# VITE_NASA_POWER_API=https://power.larc.nasa.gov/api/temporal/climatology/point

# NASA GIBS (Global Imagery Browse Services) tile endpoint
# Docs: https://nasa-gibs.github.io/gibs-api-docs/
# VITE_GIBS_TILE_ENDPOINT=https://gibs.earthdata.nasa.gov/wmts/epsg4326/best

# MapTiler / OpenFreeMap base tile service (Earth background tiles)
# Sign up at https://www.maptiler.com or use https://tiles.openfreemap.org
# VITE_MAPTILER_API_KEY=your_maptiler_api_key_here
